# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 构建源（留空=官方）
# 镜像不可达时 Dockerfile / build.sh / install.sh / update.sh 会回退官方源。
# APT_MIRROR 只写主机名（如 mirrors.aliyun.com），不要带协议。
# NODE_MAJOR 留空时镜像仍安装 Node 20。
APT_MIRROR=
NODE_MAJOR=
NODESOURCE_URL=
NPM_REGISTRY=
PLAYWRIGHT_DOWNLOAD_HOST=
ARTEX_GOPROXY=
ARTEX_GOSUMDB=
ARTEX_NPM_REGISTRY=
