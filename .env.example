# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# emp3r0r cc sidecar（可选；docker-compose profile emp3r0r）
# 凭据取自 cc 端 ~/.emp3r0r/wg_config.json（emp3r0r server --operators artex 生成）。
ARTEX_EMP3R0R=
EMP3R0R_WG_PORT=
ARTEX_EMP3R0R_ENDPOINT=
ARTEX_EMP3R0R_SERVER_KEY=
ARTEX_EMP3R0R_SERVER_IP=
ARTEX_EMP3R0R_OPERATOR_IP=
ARTEX_EMP3R0R_OPERATOR_KEY=
ARTEX_EMP3R0R_OPERATOR_PORT=
ARTEX_EMP3R0R_SESSION=
ARTEX_EMP3R0R_AGENT_BINARY=
ARTEX_EMP3R0R_POLL_INTERVAL=
ARTEX_EMP3R0R_WAIT_SECONDS=

# 构建源（留空=官方）
# 镜像不可达时 Dockerfile / build.sh / install.sh / update.sh 会回退官方源。
# APT_MIRROR 只写主机名（如 mirrors.aliyun.com），不要带协议。
# NODE_MAJOR 留空时镜像仍安装 Node 20。
APT_MIRROR=
NODE_MAJOR=
NODESOURCE_URL=
NPM_REGISTRY=
PLAYWRIGHT_DOWNLOAD_HOST=
ARTEX_GOPROXY=
ARTEX_GOSUMDB=
ARTEX_NPM_REGISTRY=
