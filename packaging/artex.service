# ARTEX systemd unit —— 崩溃自动拉起 + 开机自启
#
# 手工安装（ours 的 install.sh 目前走 Docker 或本地编译，不会自动安装本单元，
# 也不会改写 User / WorkingDirectory）：
#   sudo install -m644 packaging/artex.service /etc/systemd/system/artex.service
#   # 按实际安装路径与运行账号修改 User= 与 WorkingDirectory= / ExecStart= 中的前缀
#   sudo systemctl daemon-reload && sudo systemctl enable --now artex
#
# 与 start.sh 的关系：
#   systemd 模式下不要再套 start.sh —— 守护职责（崩溃重拉、开机自启）
#   已移交给 systemd，ExecStart 直接跑 artex 本体。
#   页面「一键更新」换装后 artex 以退出码 75 退出；Restart=on-failure
#   会把它重新拉起，新版二进制由 artex 自己在启动时完成校验/换装（selfupdate 包）。
#   退出码 0（用户正常停止 / systemctl stop）视为正常退出，不再拉起。
#   start.sh 保留给无 systemd 的环境（macOS、Windows、Docker ENTRYPOINT）。
#
# 监听地址必须是 :8787（全网卡），不要改成 127.0.0.1:8787。
[Unit]
Description=ARTEX agentic pentest platform
Documentation=https://github.com/Autumn-27/ARTEX
# 弱依赖：有网络/Postgres 就先等它们，没有也不阻止启动（库可装在别的机器上）
Wants=network-online.target postgresql.service
After=network-online.target postgresql.service
# 进程异常打满时的兜底：60s 内最多拉起 5 次，超出后进入 failed 态人工介入
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# 运行账号：默认 artex（不存在请先 useradd -r -s /usr/sbin/nologin artex，
# 或改成你的部署账号）
User=artex
# 安装目录（含 artex 二进制、config.json、skills/、data/）。按实际部署路径修改。
WorkingDirectory=/opt/artex
# 可选环境注入：文件不存在也不报错（行首的 -）。用于 ARTEX_CALLBACK_ADDR、
# ARTEX_PG_DSN 等不便写进单元文件的环境变量。
EnvironmentFile=-/etc/artex.env
ExecStart=/opt/artex/artex -addr :8787 -proxy 127.0.0.1:8788
# 崩溃/自更新重拉：固定 5s 间隔
Restart=on-failure
RestartSec=5s
# 内存上限按需开启（默认不设）。探索任务吃内存时建议：
# MemoryMax=2G
# 流量录制会开大量连接
LimitNOFILE=65535
# 日志走 journal： journalctl -u artex -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=artex

[Install]
WantedBy=multi-user.target
